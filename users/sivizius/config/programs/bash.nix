{ ... }:
{
  historyControl = [
    "erasedups"
    "ignoredups"
  ];
  historyFile = "~/.cache/bash-history.log";
  historyFileSize = 65536;
  historyIgnore = [
    "cd"
    "l"
    "l1"
    "l2"
    "l3"
    "l4"
    "l5"
    "l6"
    "l7"
    "l8"
    "l9"
    "ls"
    "lt"
    "exec"
    "exit"
  ];
  historySize = 65536;
}
